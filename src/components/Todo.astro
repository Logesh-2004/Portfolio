---
// A clearly marked placeholder for content the plan doesn't have yet.
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-block rounded border border-dashed border-muted-foreground/50 px-1.5 py-0.5 text-sm text-muted-foreground',
    className,
  ]}
>
  [TODO: {label}]
</span>
